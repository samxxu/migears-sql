{
    "name": "migears/sql",
    "description": "Lightweight SQL query builder for PHP 8.1+",
    "type": "library",
    "license": "MIT",
    "version": "2.0.0",
    "require": {
        "php": "^8.1",
        "ext-pdo": "*",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10"
    },
    "autoload": {
        "psr-4": {
